{
  "name": "@quantum-l9/infisical-config",
  "version": "1.1.0",
  "type": "module",
  "description": "Optional, graceful Infisical secret loader (Universal Auth machine identity -> process.env) shared across Quantum-L9 services. Includes refreshSecrets, SIGHUP reload, and interval rotation support.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:types": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Quantum-L9/infisical-config.git"
  },
  "dependencies": {
    "@infisical/sdk": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "UNLICENSED"
}
